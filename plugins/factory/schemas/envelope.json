{ "$comment": "Result every workflow returns. The CLI validates it in factory record.",
  "type": "object", "required": ["workflow", "job", "status", "input_hash", "budgets", "summary", "data"], "properties": {
  "workflow": { "enum": ["ground", "fanout-judge", "decompose", "realize", "reconcile"] },
  "config": { "type": ["string", "null"] }, "mode": { "type": ["string", "null"] },
  "job": { "type": "string", "pattern": "^J-\\d+$" },
  "status": { "enum": ["ok", "needs_user", "degraded", "stale", "park", "error"] },
  "next_gate": { "type": ["string", "null"] },
  "input_hash": { "type": "string" },
  "budgets": { "type": "object", "required": ["used"], "properties": { "used": { "type": "object" }, "limit": { "type": "object" } } },
  "artifacts": { "type": "array", "items": { "type": "string" } },
  "questions": { "type": "array" },
  "park_reason": { "type": ["string", "null"] },
  "summary": { "type": "string" },
  "agents": { "type": "array", "items": { "type": "object", "required": ["label", "agent_type"], "properties": {
    "label": { "type": "string" }, "agent_type": { "type": "string" }, "model": { "type": ["string", "null"] },
    "retry": { "type": "boolean" }, "outcome": { "type": "string" } } } },
  "data": { "type": "object" } } }
