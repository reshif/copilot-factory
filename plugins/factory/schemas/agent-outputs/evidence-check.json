{ "$comment": "verifier (clarify): a sceptical second look at each finding it was given: the quote is really at the source, the date and version apply, and a scope-changing claim has a second independent source.",
  "type": "object", "required": ["verdicts"], "properties": {
  "verdicts": { "type": "array", "items": { "type": "object", "required": ["evidence_id", "verdict", "confidence", "reason"], "properties": {
    "evidence_id": { "type": "string", "pattern": "^E-\\d+$" },
    "verdict": { "enum": ["confirmed", "contradicted", "unverified"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "reason": { "type": "string" },
    "quote_found": { "type": "boolean" },
    "version_applies": { "type": "boolean" },
    "second_source": { "type": ["object", "null"], "properties": { "source": { "type": "string" }, "quote": { "type": "string" } } },
    "counter_source": { "type": ["object", "null"], "properties": { "source": { "type": "string" }, "quote": { "type": "string" } } } } } } } }
