{ "$comment": "contract-writer (clarify v3): the full outcome contract and the coverage map (for every item, the AC id or section that honours it); items it could not honour are listed with why; a constraint, non-goal or AC it took out is under removed and one it reworded under changed (from, to, because: the I-n, W-n, blocker or R-n it rests on). The CLI checks it, writes it, and writes its own sections from the record.",
  "type": "object", "required": ["contract", "covers", "uncovered"], "properties": {
  "contract": { "type": "string", "minLength": 20 },
  "covers": { "type": "array", "items": { "type": "object", "required": ["item", "where"], "properties": {
    "item": { "type": "string", "pattern": "^I-\\d+$" }, "where": { "type": "string" }, "how": { "type": "string" } } } },
  "uncovered": { "type": "array", "items": { "type": "object", "required": ["item", "why"], "properties": {
    "item": { "type": "string" }, "why": { "type": "string" } } } },
  "removed": { "type": "array", "items": { "type": "object", "required": ["ref", "because"], "properties": {
    "ref": { "type": "string" }, "text": { "type": "string" }, "because": { "type": "string" }, "why": { "type": "string" } } } },
  "changed": { "type": "array", "items": { "type": "object", "required": ["ref", "from", "to", "because"], "properties": {
    "ref": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "because": { "type": "string" }, "why": { "type": "string" } } } } } }
