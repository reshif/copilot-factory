{ "type": "object", "required": ["questions", "dismissed"], "properties": {
  "questions": { "type": "array", "maxItems": 5, "items": { "type": "object", "required": ["question", "category", "why", "default", "unknown"], "properties": {
    "question": { "type": "string" }, "category": { "enum": ["intent", "scope", "constraint", "acceptance"] },
    "why": { "type": "string" }, "default": { "type": "string" },
    "options": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
    "unknown": { "type": "string" },
    "kind": { "enum": ["repo", "world", "decision", "user"] },
    "evidence": { "type": "array", "items": { "type": "string", "pattern": "^E-\\d+$" } },
    "preference": { "type": "boolean" },
    "same_as": { "type": "string", "pattern": "^(U-\\d+|new)$" },
    "subject": { "type": "string" },
    "owner": { "enum": ["research", "user", "design"] } } } },
  "held": { "type": "array", "items": { "type": "object", "required": ["question", "category"], "properties": {
    "question": { "type": "string" }, "category": { "type": "string" } } } },
  "dismissed": { "type": "array", "items": { "type": "object", "required": ["question", "reason"], "properties": {
    "question": { "type": "string" }, "reason": { "type": "string" }, "unknown": { "type": "string" } } } },
  "researchable": { "type": "array", "items": { "type": "object", "required": ["question", "unknown"], "properties": {
    "question": { "type": "string" }, "unknown": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } } } } } } }
