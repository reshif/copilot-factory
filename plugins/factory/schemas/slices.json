{
  "$comment": "Shape of .factory/jobs/<epic>/slices.json.",
  "type": "object",
  "required": [
    "slices"
  ],
  "properties": {
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "goal",
          "criteria_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S\\d+$"
          },
          "goal": {
            "type": "string",
            "minLength": 3
          },
          "criteria_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "work_type": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "epic_verify_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
