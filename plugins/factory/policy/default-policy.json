{
  "version": 1,
  "base_branch": null,
  "risk_floor": {
    "hotfix": "high",
    "migration": "high"
  },
  "work_types": [
    "feature",
    "bug",
    "hotfix",
    "refactor",
    "migration",
    "dependency",
    "docs",
    "spike",
    "greenfield"
  ],
  "required_lanes": {
    "low": [
      "code"
    ],
    "medium": [
      "code",
      "tests",
      "security"
    ],
    "high": [
      "code",
      "tests",
      "security"
    ]
  },
  "ui_paths": [
    "**/*.tsx",
    "**/*.jsx",
    "**/*.vue",
    "**/*.svelte",
    "**/*.css",
    "**/*.scss",
    "**/*.html"
  ],
  "protected_paths": [
    ".factory/**",
    ".git/**",
    ".github/workflows/**"
  ],
  "secret_paths": [
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa",
    "**/id_ed25519",
    "**/.npmrc",
    "**/.pypirc",
    "**/credentials",
    "**/credentials.json"
  ],
  "secret_exempt": [
    "**/.env.example",
    "**/.env.sample",
    "**/.env.template",
    "**/.env.dist",
    "**/*.example",
    "**/*.sample",
    "**/*.template",
    "**/*.dist"
  ],
  "checks": [],
  "limits": {
    "max_design_critique_rounds": 3,
    "max_plan_validate_rounds": 3,
    "retry_limit": 3,
    "max_review_rounds": 5,
    "max_verify_fix_rounds": 5,
    "max_reverify_rounds": 3,
    "max_parallel_tasks": 4,
    "max_parallel_research": 4,
    "max_parallel_lanes": 4,
    "max_parallel_agents": 4,
    "max_tree_depth": 2,
    "repeat_guard": 2,
    "max_agent_runs_per_job": 400,
    "max_agent_runs_per_tree": 2000,
    "max_ship_files": 200,
    "flaky_reruns": 1,
    "command_timeout_seconds": 600,
    "integrate_each_wave": true,
    "clarify_writer_rounds": 5,
    "probe_command_seconds": 120,
    "probe_timeout_seconds": 900
  },
  "decompose": {
    "plan_probe": "auto"
  },
  "deps": {
    "enabled": true,
    "max_packages": 20,
    "max_unpacked_mb": 200,
    "timeout_seconds": 180
  },
  "lessons_max_per_job": 3,
  "ci": {
    "required_check": "factory-gate"
  },
  "agents": {
    "models_enabled": true,
    "models_profile": "session-default",
    "models": {
      "interviewer": "haiku",
      "sweep-check": "haiku"
    },
    "model_ids": {
      "opus": "claude-opus-5.5",
      "sonnet": "claude-sonnet-5.5",
      "haiku": "claude-haiku-5.5"
    },
    "builder_escalation": ["opus"],
    "builder_escalation_from_attempt": 3,
    "escalate_before_park": true,
    "sweep_check": false
  },
  "copilot": {
    "flags": [],
    "permissions": "per-role",
    "allow_tools": {},
    "deny_tools": {},
    "agent_timeout_seconds": 1800,
    "resume_for_retry": true,
    "transient_retries": 4,
    "transient_backoff_seconds": 10,
    "transcript_max_bytes": 8388608,
    "transcript_keep_runs": 30,
    "transcript_max_total_bytes": 524288000,
    "transcript_closed_days": 14,
    "transcript_keep_jobs": 20,
    "transient_park_after": 3
  },
  "notify": true,
  "drive": {
    "stop_before_ship": false
  },
  "loops": {
    "ceiling": 5,
    "stall_rounds": 2,
    "escalate_model": "opus",
    "diagnose": true
  },
  "ship": {
    "mode": "auto",
    "auto_pr": false
  },
  "intent_research": {
    "web": true,
    "search_mcp": null
  },
  "clarify": {
    "readback": "show",
    "facts_sheet": false,
    "tiebreak": true,
    "max_research_passes": 2,
    "max_sheet_decisions": 5,
    "max_readiness_cycles": 3,
    "research_minutes": {
      "low": 6,
      "medium": 10,
      "high": 15
    },
    "agent_seconds": {
      "interviewer": 600,
      "brief-writer": 900,
      "contract-writer": 900,
      "god-eye": 900
    }
  }
}
