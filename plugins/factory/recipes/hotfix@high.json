{
  "id": "hotfix@high",
  "version": 2,
  "status": "proven",
  "outcome": "change",
  "description": "Hotfix: high-risk floors kept, grounding scoped to the failing path, no-adr allowed, extra post-merge review.",
  "applies_to": { "work_type": ["hotfix"], "risk": ["high"] },
  "steps": [
    { "step": "clarify", "run": "skill:clarify" },
    { "step": "H1", "run": "gate" },
    { "step": "deps", "run": "cli:deps fetch" },
    { "step": "ground", "run": "workflow:ground", "mode": "hotfix" },
    { "step": "decide", "run": "workflow:fanout-judge", "config": "decide", "threat_model": true },
    { "step": "H2", "run": "gate" },
    { "step": "decompose", "run": "workflow:decompose" },
    { "step": "H3", "run": "gate", "combined": ["plan", "environment"] },
    { "step": "realize", "run": "workflow:realize" },
    { "step": "reconcile", "run": "workflow:reconcile" },
    { "step": "prove", "run": "cli:verify run" },
    { "step": "challenge", "run": "workflow:fanout-judge", "config": "challenge", "lanes": ["all"] },
    { "step": "HS", "run": "gate" },
    { "step": "ship", "run": "skill:ship" },
    { "step": "H4", "run": "merge" },
    { "step": "post_merge_challenge", "run": "workflow:fanout-judge", "config": "challenge", "mode": "post_merge", "lanes": ["code", "security"] },
    { "step": "distill", "run": "skill:distill" },
    { "step": "close", "run": "cli:close" }
  ]
}
